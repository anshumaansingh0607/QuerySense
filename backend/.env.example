# QuerySense Configuration
# Copy this file to .env and fill in your values

# LLM Provider: "openai", "anthropic", "groq", or "mock" (default)
LLM_PROVIDER=mock

# API Keys (only needed for the provider you're using)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model override (optional — defaults to best model per provider)
# LLM_MODEL=gpt-4o

# Pipeline settings
MAX_RETRIES=3
AMBIGUITY_THRESHOLD=0.85
QUERY_TIMEOUT=10

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
